# Porta em que o nosso servidor Express vai rodar
PORT=3000

# Endereço onde o Ollama está rodando (padrão quando instalado localmente)
OLLAMA_URL=http://localhost:11434

# Nome do modelo que o Ollama deve usar (precisa ter sido baixado antes com "ollama pull <modelo>")
OLLAMA_MODEL=llama3

# Opcional: limite máximo de tokens que o modelo pode gerar por resposta
# ("num_predict" do Ollama). Sem isso, o Ollama usa o próprio padrão dele.
# OLLAMA_MAX_TOKENS=500

# Opcional: tamanho da janela de contexto ("num_ctx" do Ollama) — quanto
# texto o modelo consegue "enxergar" de uma vez (histórico + contexto do
# RAG + pergunta). Padrão do projeto: 8192. Valores altos exigem mais
# RAM/VRAM do Ollama — se tiveres vários modelos a correr ao mesmo tempo
# (ex: OLLAMA_TOOL_MODEL), um valor alto aqui pode forçar os outros a
# serem descarregados da memória.
# OLLAMA_MAX_CONTEXT=8192

# Modelo usado pelo agente "web-search" (tool-calling). O "llama3" comum
# não suporta chamar ferramentas — precisa ter sido baixado antes:
# ollama pull llama3.2
OLLAMA_TOOL_MODEL=llama3.2

# Chave do SerpAPI, usada pelo agente "web-search" pra buscar no Google.
# Tem tier gratuito — crie uma conta em https://serpapi.com e pegue a chave
# em https://serpapi.com/manage-api-key. Sem isso, o agente "web-search"
# não funciona.
SERPAPI_API_KEY=

# Modelo usado para gerar embeddings (busca em documentos / RAG)
# Precisa ter sido baixado antes: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Chroma Cloud — banco de dados vetorial do RAG (https://trychroma.com).
# Cria uma conta/DB lá, depois copia estes 3 valores em
# https://www.trychroma.com/<org>/<db>/sdk (aba "env"):
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Opcional: só se estiveres a usar um host diferente do padrão
# (api.trychroma.com) — não mexer normalmente.
# CHROMA_HOST=api.trychroma.com

# Opcional: nome da coleção usada no Chroma para guardar os embeddings.
# CHROMA_COLLECTION_NAME=ollama-chat-api-documents

# Opcional: caminho do arquivo SQLite onde o histórico de conversas fica
# salvo (sobrevive a um restart do servidor). Padrão: conversations.db
# CONVERSATION_DB_PATH=conversations.db

# --- Opcional: apenas se você quiser testar o exemplo openai.service.js ---
# Chave paga da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Modelo Whisper (Hugging Face, via @huggingface/transformers) usado para
# transcrever o campo "audio" em /api/chat — roda 100% local, sem chave e
# sem custo. Baixado automaticamente (fica em .cache/transformers) na
# primeira transcrição, ~150 MB. "Xenova/whisper-tiny" é mais rápido e leve
# (~75 MB) se preferir trocar.
WHISPER_MODEL=Xenova/whisper-base

# Opcional: força o idioma do áudio (ex: "portuguese", "english"). Sem
# isso, o Whisper detecta o idioma sozinho.
# WHISPER_LANGUAGE=portuguese
