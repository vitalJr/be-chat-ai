# Porta em que o nosso servidor Express vai rodar
PORT=3000

# Endereço onde o Ollama está rodando (padrão quando instalado localmente)
OLLAMA_URL=http://localhost:11434

# Nome do modelo que o Ollama deve usar (precisa ter sido baixado antes com "ollama pull <modelo>")
OLLAMA_MODEL=llama3

# Opcional: limite máximo de tokens que o modelo pode gerar por resposta
# ("num_predict" do Ollama). Sem isso, o Ollama usa o próprio padrão dele.
# OLLAMA_MAX_TOKENS=500

# Opcional: tamanho da janela de contexto ("num_ctx" do Ollama) — quanto
# texto o modelo consegue "enxergar" de uma vez (histórico + contexto do
# RAG + pergunta). Padrão do projeto: 4096.
# OLLAMA_MAX_CONTEXT=4096

# Modelo usado pelo agente "web-search" (tool-calling). O "llama3" comum
# não suporta chamar ferramentas — precisa ter sido baixado antes:
# ollama pull llama3.2
OLLAMA_TOOL_MODEL=llama3.2

# Chave do SerpAPI, usada pelo agente "web-search" pra buscar no Google.
# Tem tier gratuito — crie uma conta em https://serpapi.com e pegue a chave
# em https://serpapi.com/manage-api-key. Sem isso, o agente "web-search"
# não funciona.
SERPAPI_API_KEY=

# Modelo usado para gerar embeddings (busca em documentos / RAG)
# Precisa ter sido baixado antes: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Opcional: caminho do arquivo SQLite onde o histórico de conversas fica
# salvo (sobrevive a um restart do servidor). Padrão: conversations.db
# CONVERSATION_DB_PATH=conversations.db

# --- Opcional: apenas se você quiser testar o exemplo openai.service.js ---
# Chave paga da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
